# 复制为仓库根 .env（已被 gitignore），填本机/内网地址与密钥目录。
# 拉数脚本（snmis_login / pull_dcs_hourly / fetch_*）依赖这些变量。

# SNMIS / 生产报表系统地址（含或不含 /snmis 均可）
# SNMIS_BASE_URL=http://<host>:<port>/snmis

# 账密文件目录（含 SNMIS_USERNAME / SNMIS_PASSWORD 的 env 文件）
# HHV_SECRETS_DIR=C:/path/to/.svc-secrets

# SNMIS 登录会话 JSON 输出路径
# SNMIS_SESSION_FILE=

# 含凭据的 env 文件路径（默认 HHV_SECRETS_DIR/dashboard.env）
# HHV_CREDENTIALS_ENV=

# 固废运营 dashboard 业务库（地磅 vehicle_entrance 等）
# DASHBOARD_DB=C:/path/to/dashboard/dashboard.db
